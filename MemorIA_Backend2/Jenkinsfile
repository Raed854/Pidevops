// CI pipeline — MemorIA_Backend2 (GPS / geofencing, port 8081)
pipeline {
  agent any

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
  }

  environment {
    MS_NAME      = 'MemorIA_Backend2'
    IMAGE_NAME   = 'nefziraed/memoria-backend2'
    IMAGE_TAG    = 'latest'
    DOCKER_CREDS = credentials('docker-hub-credentials')
  }

  stages {
    stage('1 — Checkout') {
      steps { checkout scm }
    }

    stage('2 — Build') {
      steps {
        dir("${MS_NAME}") {
          sh 'chmod +x ./mvnw || true'
          sh './mvnw -B clean package -DskipTests'
        }
      }
    }

    stage('3 — Tests') {
      steps {
        dir("${MS_NAME}") {
          sh './mvnw -B test || true'
        }
      }
      post {
        always {
          junit allowEmptyResults: true,
                testResults: "${MS_NAME}/target/surefire-reports/*.xml"
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        dir("${MS_NAME}") {
          withSonarQubeEnv('SonarQube') {
            sh './mvnw -B sonar:sonar -Dsonar.projectKey=memoria-backend2 -Dsonar.projectName="MemorIA Backend 2"'
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: false
        }
      }
    }

    stage('4 — Docker Build') {
      steps {
        dir("${MS_NAME}") {
          sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
        }
      }
    }

    stage('5 — Docker Push') {
      steps {
        sh "echo \$DOCKER_CREDS_PSW | docker login -u \$DOCKER_CREDS_USR --password-stdin"
        sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
      }
    }

    stage('Archive JAR') {
      steps {
        archiveArtifacts artifacts: "${MS_NAME}/target/*.jar",
                         fingerprint: true,
                         allowEmptyArchive: true
      }
    }
  }

  post {
    success {
      echo "CI #${BUILD_NUMBER} OK — ${IMAGE_NAME}:${IMAGE_TAG} pushed to Docker Hub"
    }
    failure {
      echo "CI #${BUILD_NUMBER} FAILED — check logs above"
    }
    always {
      sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
      sh 'docker logout || true'
    }
  }
}
