            alert.setCreatedBy(caregiver);
            alert.setType(request.type());
            alert.setTitle(request.title() != null ? request.title() : "Manual alert from caregiver");
            alert.setDescription(request.description() != null ? request.description() : "");
            alert.setSeverity(request.severity());
            alert.setStatus(Alert.AlertStatus.UNREAD);
            alert.setRead(false);
            alert.setAutoGenerated(false);

            // Set creation date if provided, otherwise use now
            LocalDateTime createdAt = request.createdAt() != null ? request.createdAt() : LocalDateTime.now();
            alert.setCreatedAt(createdAt);
            alert.setUpdatedAt(LocalDateTime.now());

            Alert saved = alertRepository.save(alert);

            // Create recipients for alert
            try {
                createRecipientsForAlert(saved, caregiver, patient);
            } catch (Exception recipientError) {
                log.error("[caregiver-alerts] Alert {} created but recipient distribution failed: {}",
                        saved.getId(), recipientError.getMessage(), recipientError);
            }

            log.info("[caregiver-alerts] Manual alert {} created for patientId={} by caregiverId={}",
                    saved.getId(), patient.getId(), caregiverId);

            return mapAlertToCaregiverDto(saved);
        } catch (ResponseStatusException ex) {
            throw ex;
        } catch (Exception ex) {
            log.error("[caregiver-alerts] Error creating manual alert by caregiverId={}: {}",
                    caregiverId, ex.getMessage(), ex);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Failed to create alert");
        }
    }

    /**
     * Map Alert to CaregiverAlertDTO with calculated fields
     */
    private CaregiverAlertDTO mapAlertToCaregiverDto(Alert alert) {
        if (alert == null) {
            return null;
        }

        Integer gravityScore = calculateGravityScore(alert);
        String gravityExplanation = generateGravityExplanation(alert, gravityScore);
        String color = getColorFromGravityScore(gravityScore);
        boolean isCritical = gravityScore >= 70 || Alert.AlertSeverity.CRITICAL.equals(alert.getSeverity());

        String patientName = null;
        Long patientId = null;
        if (alert.getPatient() != null) {
            patientId = alert.getPatient().getId();
            patientName = toDisplayName(alert.getPatient().getUser());
        }

        String createdByRole = null;
        if (alert.getCreatedBy() != null) {
            createdByRole = normalizeRole(alert.getCreatedBy().getRole());
        }

        return new CaregiverAlertDTO(
                alert.getId(),
                patientId,
                patientName,
                alert.getType(),
                alert.getTitle(),
                alert.getDescription(),
                alert.getSeverity(),
                alert.getStatus(),
                alert.isRead(),
                alert.getCreatedAt(),
                createdByRole,
                gravityScore,
                gravityExplanation,
                color,
                isCritical,
                alert.isAutoGenerated()
        );
    }

    /**
     * Create weather-related alerts based on current weather conditions
     * Called by WeatherAlertScheduler (daily at 7 AM) or manually via WeatherController
     *
     * @param patientId Patient to generate weather alerts for
     * @param weatherService Service providing weather data
     * @return Generated alert DTO
     */
    @Transactional
    public AlertDTO generateWeatherAlert(Long patientId, WeatherDTO weatherData) {
        if (patientId == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patient ID is required");
        }

        if (weatherData == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Weather data is required");
        }

        log.info("[weather-alerts] Generating weather alert for patientId={} condition={}", 
                patientId, weatherData.getCondition());

        try {
            Patient patient = patientRepository.findById(patientId)
                    .orElseThrow(() -> new ResponseStatusException(HttpStatus.NOT_FOUND, "Patient not found"));

            // Check if weather conditions warrant an alert
            if (!shouldCreateWeatherAlert(weatherData)) {
                log.debug("[weather-alerts] Weather conditions not severe enough for alert patientId={}", patientId);
                return null;
            }

            // Generate alert content based on weather
            Map<String, String> alertContent = generateWeatherAlertContent(weatherData);
            String severity = determineWeatherAlertSeverity(weatherData);

            // Create the alert
            Alert alert = new Alert();
            alert.setPatient(patient);
            alert.setType(AlertType.WEATHER);
            alert.setTitle(alertContent.get("title"));
            alert.setDescription(alertContent.get("description"));
            alert.setSeverity(Alert.AlertSeverity.valueOf(severity));
            alert.setStatus(Alert.AlertStatus.UNREAD);
            alert.setRead(false);
            alert.setAutoGenerated(true);
            alert.setClinicalNote("Weather condition: " + weatherData.getCondition() + 
                    ", Temperature: " + weatherData.getTemperature() + "°C, " +
                    "Wind: " + weatherData.getWindSpeed() + " km/h");

            // Set source key to prevent duplicates
            String sourceKey = "WEATHER:" + patientId + ":" + LocalDateTime.now().toLocalDate();
            alert.setSourceKey(sourceKey);

            // Calculate gravity score for weather alerts
            int gravityScore = calculateWeatherAlertGravityScore(weatherData);
            alert.setGravityScore(gravityScore);
            alert.setCritical(gravityScore >= 70 || Alert.AlertSeverity.CRITICAL.equals(alert.getSeverity()));

            Alert saved = alertRepository.save(alert);

            // Create alert recipients (caregiver, doctor, patient)
            try {
                createRecipientsForAlert(saved, null, patient);
            } catch (Exception recipientError) {
                log.error("[weather-alerts] Alert {} created but recipient distribution failed: {}",
                        saved.getId(), recipientError.getMessage());
            }

            log.info("[weather-alerts] Weather alert {} created for patientId={} severity={} gravityScore={}",
                    saved.getId(), patientId, severity, gravityScore);

            return toDto(saved);

        } catch (ResponseStatusException ex) {
            throw ex;
        } catch (Exception ex) {
            log.error("[weather-alerts] Error generating weather alert for patientId={}: {}",
                    patientId, ex.getMessage(), ex);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, 
                    "Failed to generate weather alert");
        }
    }

    /**
     * Generate weather alerts for all patients (typically called by scheduler at 7 AM)
     *
     * @param weatherService Service providing weather data  
     * @return Number of alerts generated
     */
    @Transactional
    public int generateWeatherAlertsForAllPatients(WeatherService weatherService) {
        if (weatherService == null) {
            log.warn("[weather-alerts] WeatherService is null, cannot generate weather alerts");
            return 0;
        }

        log.info("[weather-alerts] Started daily weather alert generation for all patients");

        try {
            List<Patient> allPatients = patientRepository.findAll();
            int alertsGenerated = 0;

            for (Patient patient : allPatients) {
                try {
                    // Get patient's city (default to Tunis if not set)
                    String patientCity = (patient.getVille() != null && !patient.getVille().trim().isEmpty()) 
                            ? patient.getVille() 
                            : "Tunis";

                    // Fetch weather for patient's location
                    WeatherDTO weatherData = weatherService.getWeatherForPatient(patientCity);
                    
                    if (weatherData != null) {
                        // Assess risks and generate alert if needed
                        weatherData = weatherService.assessWeatherRisks(weatherData);
                        
                        if (weatherService.shouldGenerateAlert(weatherData)) {
                            AlertDTO result = generateWeatherAlert(patient.getId(), weatherData);
                            if (result != null) {
                                alertsGenerated++;
                            }
                        }
                    }
                } catch (Exception patientError) {
                    log.error("[weather-alerts] Error processing weather alert for patientId={}: {}",
                            patient.getId(), patientError.getMessage());
                    // Continue with next patient
                }
            }

            log.info("[weather-alerts] Completed daily weather alert generation. Generated {} alerts", 
                    alertsGenerated);
            return alertsGenerated;

        } catch (Exception ex) {
            log.error("[weather-alerts] Error in daily weather alert generation: {}",
                    ex.getMessage(), ex);
            return 0;
        }
    }

    /**
     * Get all weather-related alerts for a patient
     */
    @Transactional(readOnly = true)
    public List<WeatherAlertResponseDTO> getWeatherAlertsForPatient(Long patientId) {
        if (patientId == null) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Patient ID is required");
        }

        log.debug("[weather-alerts] Fetching weather alerts for patientId={}", patientId);

        try {
            List<Alert> weatherAlerts = alertRepository.findByPatientIdAndTypeOrderByCreatedAtDesc(
                    patientId, AlertType.WEATHER);

            return weatherAlerts.stream()
                    .map(this::mapAlertToWeatherDTO)
                    .toList();

        } catch (Exception ex) {
            log.error("[weather-alerts] Error fetching weather alerts for patientId={}: {}",
                    patientId, ex.getMessage(), ex);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, 
                    "Failed to fetch weather alerts");
        }
    }

    // ===== PRIVATE HELPER METHODS FOR WEATHER ALERTS =====

    private boolean shouldCreateWeatherAlert(WeatherDTO weatherData) {
        if (weatherData == null) {
            return false;
        }

        // Create alert if any risk is HIGH or if storm risk exists
        return "HIGH".equals(weatherData.getRainRisk()) ||
               "HIGH".equals(weatherData.getStormRisk()) ||
               "HIGH".equals(weatherData.getTemperatureRisk()) ||
               "HIGH".equals(weatherData.getWindRisk());
    }

    private Map<String, String> generateWeatherAlertContent(WeatherDTO weatherData) {
        // Use WeatherService's method to generate alert content
        // Since we don't have access to WeatherService here, we'll duplicate the logic
        StringBuilder title = new StringBuilder("Weather Alert");
        StringBuilder description = new StringBuilder();
        String recommendation = "Stay safe and monitor the situation.";

        if (weatherData.getTemperature() != null && weatherData.getRainRisk() != null) {
            if ("HIGH".equals(weatherData.getRainRisk())) {
                title.append(": Heavy Rain");
                description.append("Heavy rain is expected in your area. ");
                recommendation = "Avoid going outside if possible. Ensure you have an umbrella if you must go out.";
            }

            if ("HIGH".equals(weatherData.getStormRisk())) {
                if (description.length() > 0) title.append(" / ");
                title.append("Thunderstorm Alert");
                description.append("A storm or thunderstorm is expected. ");
                recommendation = "Do not go outside. Stay indoors and away from windows.";
            }

            if ("HIGH".equals(weatherData.getTemperatureRisk())) {
                if (description.length() > 0) title.append(" / ");
                if (weatherData.getTemperature() < 0) {
                    title.append("Extreme Cold");
                    description.append(String.format("Extreme cold expected (%.1f°C). ", weatherData.getTemperature()));
                    recommendation = "Dress warmly. Limit outdoor exposure to prevent frostbite.";
                } else {
                    title.append("Extreme Heat");
                    description.append(String.format("Extreme heat expected (%.1f°C). ", weatherData.getTemperature()));
                    recommendation = "Stay hydrated and avoid prolonged sun exposure.";
                }
            }

            if ("HIGH".equals(weatherData.getWindRisk())) {
                if (description.length() > 0) title.append(" / ");
                title.append("Strong Wind");
                description.append(String.format("Strong winds expected (%.1f km/h). ", weatherData.getWindSpeed()));
                recommendation = "Be cautious when going outside. Avoid open areas.";
            }
        }

        description.append("\n\nCurrent Temperature: ").append(String.format("%.1f°C", weatherData.getTemperature()));
        description.append("\nCondition: ").append(weatherData.getCondition());
        description.append("\nWind Speed: ").append(String.format("%.1f km/h", weatherData.getWindSpeed()));
        description.append("\n\nRecommendation: ").append(recommendation);

        return Map.of(
                "title", title.toString(),
                "description", description.toString(),
                "recommendation", recommendation
        );
    }

    private String determineWeatherAlertSeverity(WeatherDTO weatherData) {
        if (weatherData == null) {
            return "LOW";
        }

        // Storm or multiple HIGH risks = CRITICAL
        if ("HIGH".equals(weatherData.getStormRisk())) {
            return "CRITICAL";
        }

        int highRiskCount = 0;
        if ("HIGH".equals(weatherData.getRainRisk())) highRiskCount++;
        if ("HIGH".equals(weatherData.getTemperatureRisk())) highRiskCount++;
        if ("HIGH".equals(weatherData.getWindRisk())) highRiskCount++;

        if (highRiskCount >= 2) {
            return "CRITICAL";
        }
        if (highRiskCount > 0) {
            return "HIGH";
        }

        // Check for MEDIUM risks
        int mediumRiskCount = 0;
        if ("MEDIUM".equals(weatherData.getRainRisk())) mediumRiskCount++;
        if ("MEDIUM".equals(weatherData.getTemperatureRisk())) mediumRiskCount++;
        if ("MEDIUM".equals(weatherData.getWindRisk())) mediumRiskCount++;

        if (mediumRiskCount >= 2) {
            return "HIGH";
        }
        if (mediumRiskCount > 0) {
            return "MEDIUM";
        }

        return "LOW";
    }

    private int calculateWeatherAlertGravityScore(WeatherDTO weatherData) {
        if (weatherData == null) {
            return 0;
        }

        int score = 0;

        // Storm = +50
        if ("HIGH".equals(weatherData.getStormRisk())) {
            score += 50;
        }

        // Extreme temperature = +30
        if ("HIGH".equals(weatherData.getTemperatureRisk())) {
            score += 30;
        }

        // Heavy rain = +20
        if ("HIGH".equals(weatherData.getRainRisk())) {
            score += 20;
        }

        // Strong wind = +15
        if ("HIGH".equals(weatherData.getWindRisk())) {
            score += 15;
        }

        // MEDIUM risks add 10 each
        if ("MEDIUM".equals(weatherData.getStormRisk())) score += 10;
        if ("MEDIUM".equals(weatherData.getTemperatureRisk())) score += 10;
        if ("MEDIUM".equals(weatherData.getRainRisk())) score += 10;
        if ("MEDIUM".equals(weatherData.getWindRisk())) score += 10;

        return Math.min(score, 100);
    }

    private WeatherAlertResponseDTO mapAlertToWeatherDTO(Alert alert) {
        String patientName = null;
        Long patientId = null;

        if (alert.getPatient() != null) {
            patientId = alert.getPatient().getId();
            patientName = toDisplayName(alert.getPatient().getUser());
        }

        // Extract weather metadata from clinical note
        String weatherCondition = "Unknown";
        Double temperature = null;
        Double windSpeed = null;
        Double precipitation = null;
        String recommendation = "";

        if (alert.getClinicalNote() != null) {
            // Parse clinical note to extract weather data
            String[] parts = alert.getClinicalNote().split(", ");
            for (String part : parts) {
                if (part.contains("Weather condition:")) {
                    weatherCondition = part.replace("Weather condition: ", "").trim();
                } else if (part.contains("Temperature:")) {
                    try {
                        String temp = part.replace("Temperature: ", "").replace("°C", "").trim();
                        temperature = Double.parseDouble(temp);
                    } catch (NumberFormatException e) {
                        log.debug("Could not parse temperature from clinical note");
                    }
                } else if (part.contains("Wind:")) {
                    try {
                        String wind = part.replace("Wind: ", "").replace(" km/h", "").trim();
                        windSpeed = Double.parseDouble(wind);
                    } catch (NumberFormatException e) {
                        log.debug("Could not parse wind speed from clinical note");
                    }
                }
            }
        }

        return WeatherAlertResponseDTO.builder()
                .id(alert.getId())
                .patientId(patientId)
                .patientName(patientName)
                .title(alert.getTitle())
                .description(alert.getDescription())
                .severity(alert.getSeverity() != null ? alert.getSeverity().toString() : "MEDIUM")
                .status(alert.getStatus() != null ? alert.getStatus().toString() : "UNREAD")
                .type("WEATHER")
                .weatherCondition(weatherCondition)
                .temperature(temperature)
                .windSpeed(windSpeed)
                .precipitation(precipitation)
                .recommendation(recommendation)
                .isRead(alert.isRead())
                .isCritical(alert.isCritical())
                .gravityScore(alert.getGravityScore())
                .autoGenerated(alert.isAutoGenerated())
                .createdAt(alert.getCreatedAt())
                .updatedAt(alert.getUpdatedAt())
                .build();
    }
}
