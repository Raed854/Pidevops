// CI pipeline — MemorIA_Frontend (Angular 18 → Nginx, port 80)
pipeline {
  agent any

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
  }

  environment {
    MS_NAME      = 'MemorIA_Frontend'
    IMAGE_NAME   = 'nefziraed/memoria-frontend'
    IMAGE_TAG    = 'latest'
    DOCKER_CREDS = credentials('docker-hub-credentials')
  }

  stages {
    stage('1 — Checkout') {
      steps { checkout scm }
    }

    // The npm build runs INSIDE the Dockerfile (multi-stage), so the Jenkins
    // host doesn't need Node installed. We rely on `docker build` to produce
    // the artifact. This keeps Jenkins lean and the pipeline portable.
    stage('2 — Docker Build') {
      steps {
        dir("${MS_NAME}") {
          sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
        }
      }
    }

    stage('3 — Docker Push') {
      steps {
        sh "echo \$DOCKER_CREDS_PSW | docker login -u \$DOCKER_CREDS_USR --password-stdin"
        sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
      }
    }
  }

  post {
    success {
      echo "CI #${BUILD_NUMBER} OK — ${IMAGE_NAME}:${IMAGE_TAG} pushed to Docker Hub"
    }
    failure {
      echo "CI #${BUILD_NUMBER} FAILED — check logs above"
    }
    always {
      sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
      sh 'docker logout || true'
    }
  }
}
